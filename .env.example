# ============================================================
#  Tây Ninh GIS - Biến môi trường (Phase 0)
#  Sao chép file này thành `.env` rồi chỉnh giá trị thật.
#  TẤT CẢ chạy trên host, không dùng dịch vụ cloud bên ngoài.
# ============================================================

# --- PostgreSQL + PostGIS (chạy qua docker-compose trên host) ---
POSTGRES_USER=tayninh
POSTGRES_PASSWORD=tayninh_secret_change_me
POSTGRES_DB=tayninh_gis
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Chuỗi kết nối Prisma dùng (khi chạy API trên host, host=localhost)
DATABASE_URL=postgresql://tayninh:tayninh_secret_change_me@localhost:5433/tayninh_gis?schema=public

# --- Backend API (NestJS) ---
API_PORT=3001
# Cho phép frontend gọi (CORS)
CORS_ORIGIN=http://localhost:3000

# --- Auth (Phase 1) ---
# Sinh secret mạnh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_generate_a_strong_random_secret
JWT_EXPIRES_IN=8h

# Tài khoản Admin khởi tạo (dùng cho `npm run seed`), đổi mật khẩu ngay sau khi đăng nhập
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123456

# --- Frontend (Next.js) ---
# URL API mà trình duyệt gọi tới
NEXT_PUBLIC_API_URL=http://localhost:3001

# Bản đồ GIS — chọn provider: "leaflet" (mặc định, tile Esri công khai, không cần key),
# "google" (Google Maps JS API, cần key + billing Google Cloud đã kích hoạt) hoặc
# "goong" (nền vector Goong qua MapLibre, cần NEXT_PUBLIC_GOONG_MAPTILES_KEY).
NEXT_PUBLIC_MAP_PROVIDER=leaflet

# Key Google Maps JavaScript API — chỉ dùng khi NEXT_PUBLIC_MAP_PROVIDER=google. Key riêng
# cho web (khác key Android), lấy tại console.cloud.google.com (bật "Maps JavaScript API",
# giới hạn theo domain).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Key Goong — chỉ dùng khi NEXT_PUBLIC_MAP_PROVIDER=goong. Dùng loại "Maptiles Key" (hiển thị
# bản đồ), KHÔNG phải "API Key" (REST API) — nhầm loại sẽ bị 403. Tạo tại account.goong.io/keys,
# nên giới hạn key theo domain web thật + localhost (key nằm lộ trong JS phía trình duyệt).
# Goong tính theo lượt tải bản đồ (gói Free: 120.000 lượt/tháng), không tính theo số marker.
NEXT_PUBLIC_GOONG_MAPTILES_KEY=

# Tâm bản đồ lúc mới mở (mọi bản đồ web), dạng "vĩ độ,kinh độ". Để trống → UBND xã Thạnh Hóa,
# tỉnh Tây Ninh (10.65528,106.18222). Mỗi bản triển khai có thể đặt tâm riêng.
NEXT_PUBLIC_MAP_DEFAULT_CENTER=

# --- Lưu file trên host (Phase 0: thư mục local, chưa dùng S3/MinIO) ---
UPLOAD_DIR=./uploads

# Máy chủ định tuyến OSRM — dùng để vẽ tuyến khảo sát bám theo đường thực tế (chấm 2 điểm).
# Mặc định là máy chủ demo công khai (giới hạn tải, KHÔNG dùng cho production) — khi triển
# khai thật hãy tự dựng OSRM (dữ liệu OSM Việt Nam) và đổi URL này. Gọi lỗi → vẽ đường thẳng.
NEXT_PUBLIC_ROUTING_URL=https://router.project-osrm.org
